<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Slurp Client</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<!-- Fonts -->
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&display=swap" rel="stylesheet">
<link href="https://fonts.cdnfonts.com/css/minecraft-4" rel="stylesheet">

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:"Inter",sans-serif;
}

body{
height:100vh;
display:flex;
align-items:center;
justify-content:center;
background:radial-gradient(circle at top,#1a1a2e,#0a0a0f);
color:white;
overflow:hidden;
}

/* glowing background */

body::before{
content:"";
position:absolute;
width:600px;
height:600px;
background:linear-gradient(45deg,#7b2cff,#00d4ff);
filter:blur(160px);
opacity:.35;
}

/* card */

.card{
position:relative;
backdrop-filter:blur(20px);
background:rgba(255,255,255,0.05);
padding:60px 70px;
border-radius:18px;
text-align:center;
max-width:520px;
}

/* Minecraft title */

h1{
font-family:"Minecraft",sans-serif;
font-size:44px;
letter-spacing:1px;
margin-bottom:10px;
}

.status{
margin-top:18px;
padding:12px 18px;
border-radius:10px;
background:rgba(255,0,60,.12);
color:#ff6b81;
font-size:14px;
}

p{
margin-top:18px;
color:#b5b5b5;
font-size:15px;
line-height:1.6;
}

footer{
margin-top:30px;
font-size:12px;
color:#666;
}

</style>
</head>

<body>

<div class="card">

<h1>Slurp Client</h1>

<div class="status">
Project Discontinued
</div>

<p>
Slurp Client is no longer maintained and development has officially ended.
This page remains online for archival purposes.
</p>

<footer>
© Slurp Client
</footer>

</div>

</body>
</html>
