<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#181a20">
<title>Slurp Dashboard</title>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}

:root{
  --bg:#181a20;
  --bg-raised:#1e2028;
  --surface:#22252e;
  --surface2:#292c38;
  --surface-hover:#2e3244;
  --border:rgba(255,255,255,0.06);
  --accent:#60a5fa;
  --accent-hover:#4f96f5;
  --on-accent:#ffffff;
  --text:#f0f1f4;
  --muted:#7a8494;
  --subtle:#8b95a8;
  --success:#4ade80;
  --warning:#fbbf24;
  --error:#f87171;
  --nav-height:56px;
}

html{overflow-x:hidden}

body{
  font-family:Tahoma,Geneva,sans-serif;
  font-size:0.875rem;
  line-height:1.5;
  background:var(--bg);
  color:var(--text);
  min-height:100vh;
  -webkit-font-smoothing:antialiased;
}

nav{
  position:sticky;
  top:0;
  z-index:10;
  display:flex;
  align-items:center;
  height:var(--nav-height);
  padding:0 40px;
  background:rgba(24,26,32,0.88);
  -webkit-backdrop-filter:blur(12px);
  backdrop-filter:blur(12px);
  border-bottom:1px solid var(--border);
}

.nav-inner{
  display:flex;
  align-items:center;
  width:100%;
  max-width:900px;
  margin:0 auto;
}

.nav-logo{
  font-size:0.9375rem;
  font-weight:700;
  color:var(--text);
  text-decoration:none;
  letter-spacing:0.025em;
  flex:1;
}

.nav-tabs{
  display:flex;
  gap:28px;
  list-style:none;
}

.nav-tabs a{
  font-size:0.8125rem;
  color:var(--muted);
  text-decoration:none;
  letter-spacing:0.015em;
  transition:color .18s;
}

.nav-tabs a:hover,
.nav-tabs a.active{color:var(--text)}

.nav-right{
  flex:1;
  display:flex;
  justify-content:flex-end;
  align-items:center;
  gap:12px;
}

.nav-user{
  font-size:0.8125rem;
  color:var(--muted);
}

.nav-user span{color:var(--text);font-weight:700}

.btn-logout{
  font-size:0.75rem;
  color:var(--muted);
  background:var(--surface2);
  border:none;
  border-radius:999px;
  padding:6px 14px;
  cursor:pointer;
  font-family:Tahoma,Geneva,sans-serif;
  transition:background .18s, color .18s;
}

.btn-logout:hover{background:var(--surface-hover);color:var(--text)}

.page{
  max-width:900px;
  margin:0 auto;
  padding:40px 40px 80px;
}

.view{display:none}
.view.active{display:block}

.section-label{
  font-size:0.6875rem;
  color:var(--subtle);
  letter-spacing:0.06em;
  text-transform:uppercase;
  margin-bottom:12px;
}

.grid-2{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:12px;
  margin-bottom:32px;
}

.card{
  background:var(--surface);
  border-radius:16px;
  padding:24px;
  transition:transform .2s;
}

.card:hover{transform:translateY(-3px)}

.card-head{
  display:flex;
  align-items:center;
  justify-content:space-between;
  margin-bottom:12px;
}

.card-title{
  font-size:0.8125rem;
  font-weight:700;
  color:var(--text);
}

.badge{
  font-size:0.6875rem;
  padding:3px 10px;
  border-radius:999px;
}

.badge-green{background:rgba(74,222,128,0.12);color:var(--success)}
.badge-yellow{background:rgba(251,191,36,0.12);color:var(--warning)}

.card-rule{height:1px;background:var(--border);margin-bottom:14px}

.card-desc{
  font-size:0.8rem;
  color:var(--muted);
  line-height:1.7;
  margin-bottom:18px;
}

.btn{
  display:inline-block;
  background:var(--accent);
  color:#fff;
  font-family:Tahoma,Geneva,sans-serif;
  font-size:0.8rem;
  letter-spacing:0.025em;
  border:none;
  border-radius:999px;
  padding:8px 18px;
  cursor:pointer;
  text-decoration:none;
  transition:background .18s, transform .15s;
}

.btn:hover{background:var(--accent-hover);transform:translateY(-1px)}

.btn-ghost{
  display:inline-block;
  background:var(--surface2);
  color:var(--subtle);
  font-family:Tahoma,Geneva,sans-serif;
  font-size:0.8rem;
  border:none;
  border-radius:999px;
  padding:8px 18px;
  cursor:pointer;
  text-decoration:none;
  transition:background .18s, color .18s;
}

.btn-ghost:hover{background:var(--surface-hover);color:var(--text)}

.settings-card{
  background:var(--surface);
  border-radius:16px;
  overflow:hidden;
  margin-bottom:12px;
}

.settings-row{
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:18px 24px;
  border-bottom:1px solid var(--border);
}

.settings-row:last-child{border-bottom:none}

.settings-label{
  font-size:0.8125rem;
  color:var(--text);
  font-weight:700;
  margin-bottom:2px;
}

.settings-sub{
  font-size:0.75rem;
  color:var(--muted);
}

.settings-input{
  background:var(--surface2);
  border:none;
  border-radius:8px;
  color:var(--text);
  font-family:Tahoma,Geneva,sans-serif;
  font-size:0.8125rem;
  padding:8px 12px;
  outline:none;
  width:200px;
  transition:background .18s;
}

.settings-input:focus{background:var(--surface-hover)}

.settings-input:disabled{opacity:0.45;cursor:not-allowed}

.danger-zone{
  background:rgba(248,113,113,0.05);
  border-radius:16px;
  overflow:hidden;
  margin-bottom:12px;
}

.danger-zone .settings-row{border-bottom-color:rgba(248,113,113,0.08)}

.btn-danger{
  display:inline-block;
  background:rgba(248,113,113,0.12);
  color:var(--error);
  font-family:Tahoma,Geneva,sans-serif;
  font-size:0.8rem;
  border:none;
  border-radius:999px;
  padding:8px 18px;
  cursor:pointer;
  transition:background .18s;
}

.btn-danger:hover{background:rgba(248,113,113,0.2)}

@media(max-width:700px){
  nav{padding:0 20px}
  .page{padding:24px 20px 60px}
  .grid-2{grid-template-columns:1fr}
  .settings-input{width:140px}
}
</style>
</head>
<body>

<nav>
  <div class="nav-inner">
    <a href="#" class="nav-logo">Slurp</a>
    <ul class="nav-tabs">
      <li><a href="#" class="active" onclick="switchView('downloads');return false;">Downloads</a></li>
      <li><a href="#" onclick="switchView('configs');return false;">Cloud Configs</a></li>
      <li><a href="#" onclick="switchView('settings');return false;">Settings</a></li>
    </ul>
    <div class="nav-right">
      <p class="nav-user">Logged in as <span>x</span></p>
      <button class="btn-logout">Log out</button>
    </div>
  </div>
</nav>

<div class="page">

  <div class="view active" id="view-downloads">
    <p class="section-label">Downloads</p>
    <div class="grid-2">
      <div class="card">
        <div class="card-head">
          <span class="card-title">Slurp Client</span>
          <span class="badge badge-green">Up to date</span>
        </div>
        <div class="card-rule"></div>
        <p class="card-desc">A ghost and blatant client engineered for multi-server bypasses. Supports closet and blatant cheating across all major server networks.</p>
        <div style="display:flex;gap:8px">
          <a href="https://discord.gg/QCPzTp9e3m" target="_blank" rel="noreferrer" class="btn">Download</a>
          <button class="btn-ghost" onclick="showChangelog('client')">Changelog</button>
        </div>
      </div>
      <div class="card">
        <div class="card-head">
          <span class="card-title">Slurp Lite</span>
          <span class="badge badge-green">Up to date</span>
        </div>
        <div class="card-rule"></div>
        <p class="card-desc">A ghost client built for closet cheating. Designed to stay undetected while providing subtle advantages across supported servers.</p>
        <div style="display:flex;gap:8px">
          <a href="https://discord.gg/QCPzTp9e3m" target="_blank" rel="noreferrer" class="btn">Download</a>
          <button class="btn-ghost" onclick="showChangelog('lite')">Instructions</button>
        </div>
      </div>
    </div>
  </div>

  <div class="view" id="view-configs">
    <div id="configs-home">
      <p class="section-label">Cloud Configs</p>
      <div class="card" style="margin-bottom:12px">
        <div class="card-head">
          <span class="card-title">Config Library</span>
        </div>
        <div class="card-rule"></div>
        <p class="card-desc">Browse and download configs shared by the community. Import directly into your client with one click.</p>
        <div style="display:flex;gap:8px">
          <button class="btn" onclick="showConfigList()">Browse configs</button>
          <button class="btn-ghost" onclick="showShareForm()">Share mine</button>
        </div>
      </div>
    </div>

    <div id="configs-list" style="display:none">
      <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px">
        <button class="btn-ghost" onclick="showConfigHome()" style="padding:6px 14px;font-size:0.75rem">← Back</button>
        <p class="section-label" style="margin:0">Browse Configs</p>
      </div>
      <div class="settings-card">
        <div class="settings-row">
          <div>
            <div class="settings-label">Hypixel Blatant</div>
            <div class="settings-sub">Shared by x · 6 downloads</div>
          </div>
          <button class="btn" style="padding:6px 16px;font-size:0.75rem" onclick="downloadConfig()">Download</button>
        </div>
      </div>
    </div>

    <div id="configs-share" style="display:none">
      <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px">
        <button class="btn-ghost" onclick="showConfigHome()" style="padding:6px 14px;font-size:0.75rem">← Back</button>
        <p class="section-label" style="margin:0">Share a Config</p>
      </div>
      <div class="card">
        <div class="card-rule" style="margin-top:0;margin-bottom:20px"></div>
        <div class="field" style="margin-bottom:16px">
          <label style="display:block;font-size:0.6875rem;color:var(--subtle);letter-spacing:0.015em;margin-bottom:6px">Config name</label>
          <input class="settings-input" type="text" placeholder="e.g. Hypixel Closet Config" style="width:100%">
        </div>
        <div class="field" style="margin-bottom:16px">
          <label style="display:block;font-size:0.6875rem;color:var(--subtle);letter-spacing:0.015em;margin-bottom:6px">Description</label>
          <textarea class="settings-input" placeholder="Describe your config..." style="width:100%;height:80px;resize:vertical;font-family:Tahoma,Geneva,sans-serif;line-height:1.5"></textarea>
        </div>
        <div class="field" style="margin-bottom:20px">
          <label style="display:block;font-size:0.6875rem;color:var(--subtle);letter-spacing:0.015em;margin-bottom:6px">Config file (.json)</label>
          <input class="settings-input" type="file" accept=".json" style="width:100%;padding:8px 12px">
        </div>
        <button class="btn" onclick="submitConfig()">Submit config</button>
      </div>
    </div>
  </div>

  <div class="view" id="view-settings">
    <p class="section-label">Account</p>
    <div class="settings-card">
      <div class="settings-row">
        <div>
          <div class="settings-label">Username</div>
          <div class="settings-sub">Your account username</div>
        </div>
        <input class="settings-input" type="text" value="x" disabled>
      </div>
      <div class="settings-row">
        <div>
          <div class="settings-label">Email</div>
          <div class="settings-sub">Your account email address</div>
        </div>
        <input class="settings-input" type="email" value="xwhere942@gmail.com" disabled>
      </div>
      <div class="settings-row">
        <div>
          <div class="settings-label">HWID</div>
          <div class="settings-sub">Hardware ID reset, changeable once every 30 days</div>
        </div>
        <button class="btn-ghost" onclick="showModal('hwid')">Reset HWID</button>
      </div>
      <div class="settings-row">
        <div>
          <div class="settings-label">Password</div>
          <div class="settings-sub">Change your account password</div>
        </div>
        <button class="btn-ghost" onclick="showModal('password')">Change password</button>
      </div>
    </div>

    <p class="section-label" style="margin-top:24px">Danger zone</p>
    <div class="danger-zone">
      <div class="settings-row">
        <div>
          <div class="settings-label">Delete account</div>
          <div class="settings-sub">Permanently delete your account and all data</div>
        </div>
        <button class="btn-danger" onclick="showModal('delete')">Delete account</button>
      </div>
    </div>
  </div>

</div>

<div id="modal-overlay" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.6);z-index:100;display:none;align-items:center;justify-content:center" onclick="closeModal(event)">
  <div id="modal-box" style="background:var(--surface);border-radius:16px;padding:28px 32px;width:100%;max-width:420px;margin:20px;position:relative" onclick="event.stopPropagation()">
    <div id="modal-content"></div>
  </div>
</div>

<script>
(function(){
  document.addEventListener('contextmenu', function(e){ e.preventDefault(); });
  document.addEventListener('keydown', function(e){
    if(
      e.key === 'F12' ||
      (e.ctrlKey && e.shiftKey && ['I','J','C','U'].includes(e.key.toUpperCase())) ||
      (e.ctrlKey && e.key.toUpperCase() === 'U')
    ){ e.preventDefault(); e.stopPropagation(); }
  });
})();

function switchView(view) {
  ['downloads','configs','settings'].forEach(function(v){
    document.getElementById('view-' + v).classList.toggle('active', v === view);
  });
  document.querySelectorAll('.nav-tabs a').forEach(function(a){ a.classList.remove('active'); });
  event.target.classList.add('active');
}

function showConfigList() {
  document.getElementById('configs-home').style.display = 'none';
  document.getElementById('configs-list').style.display = 'block';
  document.getElementById('configs-share').style.display = 'none';
}

function showShareForm() {
  document.getElementById('configs-home').style.display = 'none';
  document.getElementById('configs-list').style.display = 'none';
  document.getElementById('configs-share').style.display = 'block';
}

function showConfigHome() {
  document.getElementById('configs-home').style.display = 'block';
  document.getElementById('configs-list').style.display = 'none';
  document.getElementById('configs-share').style.display = 'none';
}

function submitConfig() {
  var name = document.querySelector('#configs-share input[type=text]').value.trim();
  if(!name){ alert('Please enter a config name.'); return; }
  openModal('<div style="font-size:0.9375rem;font-weight:700;color:var(--text);margin-bottom:8px">Config submitted!</div><p style="font-size:0.8rem;color:var(--muted);margin-bottom:20px">Your config has been submitted for review.</p><button class="btn" style="width:100%" onclick="closeModalDirect();showConfigHome()">Done</button>');
}

function downloadConfig() {
  openModal('<div style="font-size:0.9375rem;font-weight:700;color:var(--text);margin-bottom:8px">Download started</div><p style="font-size:0.8rem;color:var(--muted);margin-bottom:20px">Hypixel Blatant config is downloading.</p><button class="btn" style="width:100%" onclick="closeModalDirect()">Close</button>');
}

function showChangelog(type) {
  var content = type === 'client'
    ? '<div style="font-size:0.9375rem;font-weight:700;color:var(--text);margin-bottom:8px">Slurp Client Changelog</div><p style="font-size:0.8rem;color:var(--muted);margin-bottom:20px">No changelog available yet.</p><button class="btn-ghost" style="width:100%" onclick="closeModalDirect()">Close</button>'
    : '<div style="font-size:0.9375rem;font-weight:700;color:var(--text);margin-bottom:4px">Slurp Lite Instructions</div><p style="font-size:0.75rem;color:var(--muted);margin-bottom:16px">Setup guide</p><div style="font-size:0.8rem;color:var(--muted);line-height:1.8">1. Download Slurp Lite<br>2. Run the installer<br>3. Launch Minecraft<br>4. Inject via the loader<br>5. Press INSERT to open the menu</div><br><button class="btn-ghost" style="width:100%" onclick="closeModalDirect()">Close</button>';
  openModal(content);
}

function showModal(type) {
  var content = '';
  if(type === 'hwid'){
    content = '<div style="font-size:0.9375rem;font-weight:700;color:var(--text);margin-bottom:8px">Reset HWID</div><p style="font-size:0.8rem;color:var(--muted);margin-bottom:20px">Are you sure you want to reset your hardware ID? You won\'t be able to do this again for 30 days.</p><div style="display:flex;gap:8px"><button class="btn" style="flex:1" onclick="closeModalDirect()">Confirm reset</button><button class="btn-ghost" style="flex:1" onclick="closeModalDirect()">Cancel</button></div>';
  } else if(type === 'password'){
    content = '<div style="font-size:0.9375rem;font-weight:700;color:var(--text);margin-bottom:16px">Change Password</div><div style="margin-bottom:12px"><label style="display:block;font-size:0.6875rem;color:var(--subtle);margin-bottom:6px">Current password</label><input type="password" class="settings-input" placeholder="••••••••" style="width:100%"></div><div style="margin-bottom:12px"><label style="display:block;font-size:0.6875rem;color:var(--subtle);margin-bottom:6px">New password</label><input type="password" class="settings-input" placeholder="••••••••" style="width:100%"></div><div style="margin-bottom:20px"><label style="display:block;font-size:0.6875rem;color:var(--subtle);margin-bottom:6px">Confirm new password</label><input type="password" class="settings-input" placeholder="••••••••" style="width:100%"></div><div style="display:flex;gap:8px"><button class="btn" style="flex:1" onclick="closeModalDirect()">Save</button><button class="btn-ghost" style="flex:1" onclick="closeModalDirect()">Cancel</button></div>';
  } else if(type === 'delete'){
    content = '<div style="font-size:0.9375rem;font-weight:700;color:var(--error);margin-bottom:8px">Delete account</div><p style="font-size:0.8rem;color:var(--muted);margin-bottom:16px">This will permanently delete your account and all associated data. This cannot be undone.</p><div style="margin-bottom:20px"><label style="display:block;font-size:0.6875rem;color:var(--subtle);margin-bottom:6px">Enter your password to confirm</label><input type="password" class="settings-input" placeholder="••••••••" style="width:100%"></div><div style="display:flex;gap:8px"><button class="btn-danger" style="flex:1" onclick="closeModalDirect()">Delete permanently</button><button class="btn-ghost" style="flex:1" onclick="closeModalDirect()">Cancel</button></div>';
  }
  openModal(content);
}

function openModal(html) {
  document.getElementById('modal-content').innerHTML = html;
  var overlay = document.getElementById('modal-overlay');
  overlay.style.display = 'flex';
}

function closeModal(e) {
  if(e.target === document.getElementById('modal-overlay')) closeModalDirect();
}

function closeModalDirect() {
  document.getElementById('modal-overlay').style.display = 'none';
}

document.querySelector('.btn-logout').addEventListener('click', function(){
  openModal('<div style="font-size:0.9375rem;font-weight:700;color:var(--text);margin-bottom:8px">Log out</div><p style="font-size:0.8rem;color:var(--muted);margin-bottom:20px">Are you sure you want to log out?</p><div style="display:flex;gap:8px"><button class="btn" style="flex:1" onclick="closeModalDirect()">Log out</button><button class="btn-ghost" style="flex:1" onclick="closeModalDirect()">Cancel</button></div>');
});
</script>
</body>
</html>
